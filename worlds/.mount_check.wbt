#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/RobotGround.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/epson/scara_t6/protos/ScaraT6.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/niryo/ned/protos/Ned.proto"
EXTERNPROTO "../protos/GroundMount.proto"
EXTERNPROTO "../protos/FlangeBolts.proto"

WorldInfo {
  info [
    "Two separate 1.6 m x 1.6 m grounds; 0.4 m gap; grid spacing 0.2 m."
    "Official Webots robot meshes retain their native metre scale."
    "SCARA staticBase TRUE; Ned root is static in the official model."
  ]
  basicTimeStep 16
}
DEF OVERVIEW Viewpoint {
  orientation -0.2913383605138376 0.29024788502555005 0.9115251641788635 1.66703351683261
  position 1.05 -4.5 3.05
  description "Both robots at real-world metre scale"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
DEF SCARA_GROUND RobotGround {
  name "SCARA ground - 1.6 m square"
  labelTexture [
    "../protos/textures/scara-label.png"
  ]
}
DEF NED_GROUND RobotGround {
  translation 2 0 0
  name "Niryo Ned ground - 1.6 m square"
  labelTexture [
    "../protos/textures/ned-label.png"
  ]
  color 0.2 0.34 0.36
}
DEF NED_MOUNT GroundMount {
  translation 2 0 0
  name "Niryo Ned floor plate - four M8 visual anchors"
  plateSize 0.3 0.3 0.012
  anchorInset 0.025 0.025
  boltDiameter 0.008
}
DEF NED Ned {
  translation 2 0 0.0125
  rotation 0 0 -1 1.5707963267948966
  name "Niryo Ned"
  controllerArgs [
    "--exercise"
  ]
}
DEF SCARA_MOUNT GroundMount {
  translation 0.013 0 0
  name "SCARA floor plate - four M12 visual anchors"
}
DEF SCARA ScaraT6 {
  translation 0 0 0.021037
  controller "scara"
  controllerArgs [
    "--exercise"
  ]
  staticBase TRUE
}
FlangeBolts {
  translation 0 0 0.021037
  positions [
    -0.06421 -0.07134 -0.003253
    -0.06421 0.07134 -0.003253
    0.07848 -0.07134 -0.003253
    0.07848 0.07134 -0.003253
  ]
}
Robot {
  name "mount validation"
  controller "check_mounts"
  supervisor TRUE
}
